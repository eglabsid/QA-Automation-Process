# Optional Gemini/API analysis for AutoQA_llm.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional local FFmpeg path for sound-effect extraction.
# Use either a CompressO-bundled ffmpeg.exe path or a normal ffmpeg binary.
COMPRESSO_FFMPEG_PATH=
FFMPEG_PATH=

# Optional Qt override for Linux/WSL display servers.
# Examples: xcb, wayland, offscreen
QT_QPA_PLATFORM=
